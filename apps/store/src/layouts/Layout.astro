---
import type { AstroGlobal } from 'astro';

interface Props {
  title?: string;
}

const { title = 'Provifood Store' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-white">
    <slot />
  </body>
</html>
