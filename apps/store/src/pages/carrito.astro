---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/layout/TopBar.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';

// Items del carrito - En producción vendrían del estado/localStorage
const cartItems = [
  {
    id: '1',
    name: 'Aceite de Girasol Premium 1.5L',
    price: 3500,
    quantity: 2,
    image: '',
    category: 'Aceites',
    inStock: true
  },
  {
    id: '2',
    name: 'Harina 000 x 1kg',
    price: 850,
    quantity: 5,
    image: '',
    category: 'Harinas',
    inStock: true
  },
  {
    id: '3',
    name: 'Arroz Grado 1 x 1kg',
    price: 1200,
    quantity: 3,
    image: '',
    category: 'Arroz',
    inStock: true
  }
];

const subtotal = cartItems.reduce((acc, item) => acc + (item.price * item.quantity), 0);
const shipping = subtotal > 50000 ? 0 : 3500;
const total = subtotal + shipping;
---

<Layout title="Carrito de Compras - Provifood">
  <TopBar />
  <Navbar />
  
  <main class="bg-gradient-to-b from-gray-50 to-white min-h-screen py-12">
    <div class="container mx-auto px-4">
      <!-- Header del carrito -->
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-provifood-dark mb-2">Carrito de Compras</h1>
        <nav class="flex items-center space-x-2 text-sm">
          <a href="/" class="text-provifood-gray hover:text-provifood-primary transition-colors">Inicio</a>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-provifood-primary font-medium">Carrito</span>
        </nav>
      </div>

      {cartItems.length > 0 ? (
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Lista de productos -->
          <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-gray-100">
              <!-- Header -->
              <div class="bg-gradient-to-r from-provifood-primary to-teal-600 px-6 py-4">
                <h2 class="text-xl font-bold text-white">Productos en tu carrito</h2>
                <p class="text-white/80 text-sm">{cartItems.length} productos</p>
              </div>

              <!-- Lista compacta de productos -->
              <div class="divide-y divide-gray-100">
                {cartItems.map((item, index) => (
                  <div class="p-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-center gap-4">
                      <!-- Imagen pequeña -->
                      <div class="w-16 h-16 flex-shrink-0 bg-gray-50 rounded-lg flex items-center justify-center border border-gray-200">
                        {item.image ? (
                          <img src={item.image} alt={item.name} class="max-w-full max-h-full object-contain p-1" />
                        ) : (
                          <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                        )}
                      </div>

                      <!-- Info del producto -->
                      <div class="flex-1 min-w-0">
                        <h3 class="font-semibold text-provifood-dark text-sm mb-0.5 truncate">
                          {item.name}
                        </h3>
                        <p class="text-xs text-provifood-gray">{item.category}</p>
                      </div>

                      <!-- Selector de cantidad -->
                      <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden">
                        <button class="px-2.5 py-1.5 hover:bg-gray-100 transition-colors" aria-label="Disminuir cantidad">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M20 12H4" />
                          </svg>
                        </button>
                        <span class="px-4 py-1.5 text-sm font-bold text-provifood-dark border-x border-gray-200 min-w-[3rem] text-center">
                          {item.quantity}
                        </span>
                        <button class="px-2.5 py-1.5 hover:bg-gray-100 transition-colors" aria-label="Aumentar cantidad">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" />
                          </svg>
                        </button>
                      </div>

                      <!-- Precio -->
                      <div class="text-right min-w-[100px]">
                        <p class="text-xs text-provifood-gray mb-0.5">Precio unit.</p>
                        <p class="text-sm font-bold text-provifood-primary">
                          ${item.price.toLocaleString('es-CL')}
                        </p>
                        <p class="text-xs text-provifood-dark font-semibold mt-1">
                          Total: ${(item.price * item.quantity).toLocaleString('es-CL')}
                        </p>
                      </div>

                      <!-- Botón eliminar -->
                      <button class="text-gray-300 hover:text-red-500 transition-colors p-2" aria-label="Eliminar producto">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                      </button>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Footer con botones -->
              <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
                <div class="flex flex-col sm:flex-row gap-3">
                  <Button href="/productos" variant="outline" class="flex-1 justify-center text-sm">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Seguir Comprando
                  </Button>
                  <button class="flex-1 px-4 py-2.5 border-2 border-red-500 text-red-500 font-semibold rounded-lg hover:bg-red-500 hover:text-white transition-all duration-300 text-sm flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    Vaciar Carrito
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Resumen del pedido -->
          <div class="lg:col-span-1">
            <div class="bg-white rounded-2xl shadow-lg sticky top-24 border border-gray-200 overflow-hidden">
              <!-- Header del resumen -->
              <div class="bg-gradient-to-r from-provifood-primary to-teal-600 p-6">
                <h2 class="text-2xl font-bold text-white">Resumen del Pedido</h2>
                <p class="text-white/90 text-sm mt-2">{cartItems.length} productos</p>
              </div>

              <div class="p-6">
                <!-- Desglose -->
                <div class="space-y-5 mb-6">
                  <div class="flex justify-between items-center">
                    <span class="text-provifood-gray font-medium">Subtotal</span>
                    <span class="text-2xl font-bold text-provifood-dark">${subtotal.toLocaleString('es-CL')}</span>
                  </div>

                  <div class="h-px bg-gray-200"></div>

                  <div class="flex justify-between items-center">
                    <span class="text-provifood-gray font-medium">Envío</span>
                    {shipping === 0 ? (
                      <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-xl font-bold text-green-600">¡Gratis!</span>
                      </div>
                    ) : (
                      <span class="text-2xl font-bold text-provifood-dark">${shipping.toLocaleString('es-CL')}</span>
                    )}
                  </div>

                  {subtotal < 50000 && (
                    <>
                      <div class="h-px bg-gray-200"></div>
                      <div class="bg-gradient-to-r from-blue-50 to-blue-100 border-2 border-blue-200 rounded-xl p-4">
                        <div class="flex items-start gap-3">
                          <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          <div>
                            <p class="text-sm font-bold text-blue-800 mb-1.5">¡Envío gratis próximo!</p>
                            <p class="text-sm text-blue-700">
                              Agrega <strong>${(50000 - subtotal).toLocaleString('es-CL')}</strong> más
                            </p>
                          </div>
                        </div>
                      </div>
                    </>
                  )}
                </div>

                <div class="h-px bg-gray-300 my-6"></div>

                <!-- Total -->
                <div class="bg-gradient-to-br from-provifood-primary/10 to-teal-50 rounded-2xl p-6 border-2 border-provifood-primary/20 mb-6">
                  <div class="flex justify-between items-baseline mb-2">
                    <span class="text-lg font-bold text-provifood-dark">Total a Pagar</span>
                    <div class="text-right">
                      <div class="text-4xl font-black text-provifood-primary">
                        ${total.toLocaleString('es-CL')}
                      </div>
                      <p class="text-xs text-provifood-gray mt-2">IVA incluido</p>
                    </div>
                  </div>
                </div>

                <!-- Botón de checkout -->
                <Button href="/checkout" class="w-full text-lg py-4 shadow-lg hover:shadow-xl mb-6">
                  Proceder al Pago
                  <svg class="w-6 h-6 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </Button>

                <div class="h-px bg-gray-200 my-6"></div>

                <!-- Garantías -->
                <div class="space-y-5">
                  <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                      </svg>
                    </div>
                    <div>
                      <p class="font-semibold text-provifood-dark text-sm mb-1">Compra 100% segura</p>
                      <p class="text-xs text-provifood-gray leading-relaxed">Protegemos tus datos</p>
                    </div>
                  </div>

                  <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                      </svg>
                    </div>
                    <div>
                      <p class="font-semibold text-provifood-dark text-sm mb-1">Entrega rápida</p>
                      <p class="text-xs text-provifood-gray leading-relaxed">24-48 horas hábiles</p>
                    </div>
                  </div>

                  <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                      </svg>
                    </div>
                    <div>
                      <p class="font-semibold text-provifood-dark text-sm mb-1">Múltiples pagos</p>
                      <p class="text-xs text-provifood-gray leading-relaxed">Débito, crédito y más</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <!-- Carrito vacío -->
        <div class="bg-white rounded-2xl shadow-lg p-16 text-center max-w-2xl mx-auto border-2 border-gray-100">
          <div class="w-32 h-32 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-provifood-dark mb-3">Tu carrito está vacío</h2>
          <p class="text-provifood-gray mb-8 text-lg">Agrega productos para comenzar tu pedido</p>
          <Button href="/productos" size="lg" class="shadow-lg">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            Ver Productos
          </Button>
        </div>
      )}
    </div>
  </main>
  
  <Footer />
</Layout>

<script>
  // Manejo de cantidades y eliminación de productos
  document.addEventListener('DOMContentLoaded', () => {
    // Botones de aumentar/disminuir cantidad
    const decreaseButtons = document.querySelectorAll('[aria-label="Disminuir cantidad"]');
    const increaseButtons = document.querySelectorAll('[aria-label="Aumentar cantidad"]');
    
    decreaseButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        const quantitySpan = btn.nextElementSibling as HTMLElement;
        let quantity = parseInt(quantitySpan.textContent || '1');
        if (quantity > 1) {
          quantity--;
          quantitySpan.textContent = quantity.toString();
          // Aquí iría la lógica para actualizar el carrito
        }
      });
    });
    
    increaseButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        const quantitySpan = btn.previousElementSibling as HTMLElement;
        let quantity = parseInt(quantitySpan.textContent || '1');
        quantity++;
        quantitySpan.textContent = quantity.toString();
        // Aquí iría la lógica para actualizar el carrito
      });
    });

    // Botones de eliminar producto
    const deleteButtons = document.querySelectorAll('[aria-label="Eliminar producto"]');
    deleteButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (confirm('¿Estás seguro de eliminar este producto?')) {
          // Aquí iría la lógica para eliminar del carrito
          const productRow = btn.closest('.p-6');
          productRow?.remove();
        }
      });
    });

    // Botón vaciar carrito
    const emptyCartBtn = document.querySelector('.border-red-500');
    emptyCartBtn?.addEventListener('click', () => {
      if (confirm('¿Estás seguro de vaciar todo el carrito?')) {
        // Aquí iría la lógica para vaciar el carrito
        window.location.reload();
      }
    });
  });
</script>
