---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/layout/TopBar.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Carrito de Compras - Provifood">
  <TopBar />
  <Navbar />

  <main class="bg-gradient-to-b from-gray-50 to-white min-h-screen py-12">
    <div class="container mx-auto px-4">
      <!-- Header del carrito -->
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-provifood-dark mb-2">Carrito de Compras</h1>
        <nav class="flex items-center space-x-2 text-sm">
          <a href="/" class="text-provifood-gray hover:text-provifood-primary">Inicio</a>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-provifood-primary font-medium">Carrito</span>
        </nav>
      </div>

      <!-- Contenedor del carrito (se renderiza dinámicamente) -->
      <div id="cart-container"></div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import {
    $cart,
    $cartItems,
    $cartTotals,
    incrementQuantity,
    decrementQuantity,
    removeFromCart,
    clearCart,
    formatPrice,
  } from '@/stores/cart'

  function renderCart() {
    const container = document.getElementById('cart-container');
    if (!container) return;

    const cart = $cartItems.get();
    const totals = $cartTotals.get();

    if (cart.length === 0) {
      container.innerHTML = `
        <div class="bg-white rounded-2xl shadow-lg p-16 text-center max-w-2xl mx-auto border-2 border-gray-100">
          <div class="w-32 h-32 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-provifood-dark mb-3">Tu carrito está vacío</h2>
          <p class="text-provifood-gray mb-8 text-lg">Agrega productos para comenzar tu pedido</p>
          <a href="/productos" class="inline-flex items-center px-6 py-3 bg-provifood-primary text-white font-semibold rounded-lg hover:bg-teal-700 transition-colors shadow-lg">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            Ver Productos
          </a>
        </div>
      `;
      return;
    }

    const shippingIsFree = totals.shipping === 0;
    const amountForFreeShipping = totals.subtotal < 50000 ? 50000 - totals.subtotal : 0;

    container.innerHTML = `
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Lista de productos -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-gray-100">
            <!-- Header -->
            <div class="bg-gradient-to-r from-provifood-primary to-teal-600 px-6 py-4">
              <h2 class="text-xl font-bold text-white">Productos en tu carrito</h2>
              <p class="text-white/80 text-sm">${cart.length} productos</p>
            </div>

            <!-- Lista de productos -->
            <div class="divide-y divide-gray-100">
              ${cart.map((item) => {
                const itemTotal = item.price * item.quantity;
                const isAtMaxStock = item.quantity >= item.stock;
                const isLowStock = item.stock > 0 && item.quantity > item.stock * 0.8;

                return `
                <div class="p-4 hover:bg-gray-50">
                  <div class="flex items-center gap-4">
                    <!-- Imagen -->
                    <div class="w-16 h-16 flex-shrink-0 bg-gray-50 rounded-lg flex items-center justify-center border border-gray-200">
                      ${item.image ?
                        `<img src="${item.image}" alt="${item.name}" class="max-w-full max-h-full object-contain p-1" />` :
                        `<svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>`
                      }
                    </div>

                    <!-- Info -->
                    <div class="flex-1 min-w-0">
                      <h3 class="font-semibold text-provifood-dark text-sm mb-0.5 truncate">
                        ${item.name}
                      </h3>
                      ${item.brand ? `<p class="text-xs text-gray-500">${item.brand}</p>` : ''}
                      ${isAtMaxStock
                        ? `<p class="text-xs text-orange-600 font-semibold flex items-center gap-1 mt-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            Máximo disponible
                          </p>`
                        : isLowStock
                        ? `<p class="text-xs text-yellow-600 font-semibold mt-1">Stock limitado</p>`
                        : ''
                      }
                      ${item.promotion ? `
                        <div class="mt-1 inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs px-2 py-0.5 rounded-full">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                          </svg>
                          ${item.promotion.description}
                        </div>
                      ` : ''}
                    </div>

                    <!-- Cantidad -->
                    <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden">
                      <button
                        class="decrease-qty px-2.5 py-1.5 hover:bg-gray-100 transition-colors"
                        data-id="${item.id}"
                        aria-label="Disminuir cantidad"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M20 12H4" />
                        </svg>
                      </button>
                      <span class="px-4 py-1.5 text-sm font-bold text-provifood-dark border-x border-gray-200 min-w-[3rem] text-center">
                        ${item.quantity}
                      </span>
                      <button
                        class="increase-qty px-2.5 py-1.5 hover:bg-gray-100 transition-colors ${isAtMaxStock ? 'opacity-50 cursor-not-allowed' : ''}"
                        data-id="${item.id}"
                        aria-label="Aumentar cantidad"
                        ${isAtMaxStock ? 'disabled' : ''}
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" />
                        </svg>
                      </button>
                    </div>

                    <!-- Precio -->
                    <div class="text-right min-w-[100px]">
                      <p class="text-xs text-provifood-gray mb-0.5">Precio unit.</p>
                      ${item.originalPrice && item.originalPrice > item.price ? `
                        <p class="text-xs text-gray-400 line-through">
                          ${formatPrice(item.originalPrice)}
                        </p>
                      ` : ''}
                      <p class="text-sm font-bold text-provifood-primary">
                        ${formatPrice(item.price)}
                      </p>
                      <p class="text-xs text-provifood-dark font-semibold mt-1">
                        Total: ${formatPrice(itemTotal)}
                      </p>
                    </div>

                    <!-- Eliminar -->
                    <button
                      class="remove-item text-gray-300 hover:text-red-500 p-2 transition-colors"
                      data-id="${item.id}"
                      aria-label="Eliminar producto"
                      title="Eliminar ${item.name}"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </button>
                  </div>
                </div>
              `}).join('')}
            </div>

            <!-- Footer -->
            <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
              <div class="flex flex-col sm:flex-row gap-3">
                <a href="/productos" class="flex-1 inline-flex items-center justify-center px-4 py-2.5 border-2 border-provifood-primary text-provifood-primary font-semibold rounded-lg hover:bg-provifood-primary hover:text-white text-sm transition-colors">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  Seguir Comprando
                </a>
                <button id="empty-cart-btn" class="flex-1 px-4 py-2.5 border-2 border-red-500 text-red-500 font-semibold rounded-lg hover:bg-red-500 hover:text-white text-sm flex items-center justify-center gap-2 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  Vaciar Carrito
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Resumen -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-2xl shadow-lg sticky top-24 border border-gray-200 overflow-hidden">
            <div class="bg-gradient-to-r from-provifood-primary to-teal-600 p-6">
              <h2 class="text-2xl font-bold text-white">Resumen del Pedido</h2>
              <p class="text-white/90 text-sm mt-2">${cart.length} productos</p>
            </div>

            <div class="p-6">
              <div class="space-y-5 mb-6">
                <div class="flex justify-between items-center">
                  <span class="text-provifood-gray font-medium">Subtotal</span>
                  <span class="text-2xl font-bold text-provifood-dark">${formatPrice(totals.subtotal)}</span>
                </div>

                ${totals.discounts > 0 ? `
                  <div class="flex justify-between items-center">
                    <span class="text-green-600 font-medium flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                      </svg>
                      Descuentos
                    </span>
                    <span class="text-2xl font-bold text-green-600">-${formatPrice(totals.discounts)}</span>
                  </div>
                ` : ''}

                <div class="h-px bg-gray-200"></div>

                <div class="flex justify-between items-center">
                  <span class="text-provifood-gray font-medium">Envío</span>
                  ${shippingIsFree ?
                    `<div class="flex items-center gap-2">
                      <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="text-xl font-bold text-green-600">¡Gratis!</span>
                    </div>` :
                    `<span class="text-2xl font-bold text-provifood-dark">${formatPrice(totals.shipping)}</span>`
                  }
                </div>

                ${amountForFreeShipping > 0 ?
                  `<div class="h-px bg-gray-200"></div>
                  <div class="bg-gradient-to-r from-blue-50 to-blue-100 border-2 border-blue-200 rounded-xl p-4">
                    <div class="flex items-start gap-3">
                      <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <div>
                        <p class="text-sm font-bold text-blue-800 mb-1.5">¡Envío gratis próximo!</p>
                        <p class="text-sm text-blue-700">
                          Agrega <strong>${formatPrice(amountForFreeShipping)}</strong> más
                        </p>
                      </div>
                    </div>
                  </div>` : ''
                }
              </div>

              <div class="h-px bg-gray-300 my-6"></div>

              <div class="bg-gradient-to-br from-provifood-primary/10 to-teal-50 rounded-2xl p-6 border-2 border-provifood-primary/20 mb-6">
                <div class="flex justify-between items-baseline mb-2">
                  <span class="text-lg font-bold text-provifood-dark">Total a Pagar</span>
                  <div class="text-right">
                    <div class="text-4xl font-black text-provifood-primary">
                      ${formatPrice(totals.total)}
                    </div>
                    <p class="text-xs text-provifood-gray mt-2">IVA incluido</p>
                  </div>
                </div>
              </div>

              <a href="/checkout" class="block w-full text-center bg-provifood-primary hover:bg-teal-700 text-white font-bold text-lg py-4 px-6 rounded-lg transition-colors shadow-lg hover:shadow-xl mb-6">
                Proceder al Pago
                <svg class="w-6 h-6 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <div class="h-px bg-gray-200 my-6"></div>

              <div class="space-y-5">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-provifood-dark text-sm mb-1">Compra 100% segura</p>
                    <p class="text-xs text-provifood-gray leading-relaxed">Protegemos tus datos</p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-provifood-dark text-sm mb-1">Entrega rápida</p>
                    <p class="text-xs text-provifood-gray leading-relaxed">24-48 horas hábiles</p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-provifood-dark text-sm mb-1">Múltiples pagos</p>
                    <p class="text-xs text-provifood-gray leading-relaxed">Débito, crédito y más</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    `;

    // Agregar event listeners después de renderizar
    attachEventListeners();
  }

  function attachEventListeners() {
    // Botones de disminuir cantidad
    document.querySelectorAll('.decrease-qty').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        decrementQuantity(id);
      });
    });

    // Botones de aumentar cantidad
    document.querySelectorAll('.increase-qty').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        incrementQuantity(id);
      });
    });

    // Botones de eliminar
    document.querySelectorAll('.remove-item').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        const cart = $cartItems.get();
        const item = cart.find(i => i.id.toString() === id);

        if (confirm(`¿Estás seguro de eliminar ${item?.name || 'este producto'}?`)) {
          removeFromCart(id);
        }
      });
    });

    // Botón vaciar carrito
    const emptyBtn = document.getElementById('empty-cart-btn');
    if (emptyBtn) {
      emptyBtn.addEventListener('click', () => {
        if (confirm('¿Estás seguro de vaciar todo el carrito?')) {
          clearCart();
        }
      });
    }
  }

  // Variable para almacenar la desuscripción
  let unsubscribeCart = null;

  function setupCartSubscription() {
    // Desuscribirse si ya existe una subscripción previa
    if (unsubscribeCart) {
      unsubscribeCart();
    }

    // Crear nueva subscripción SOLO al store base, no a los computed
    // Esto evita cascadas de notificaciones
    unsubscribeCart = $cart.subscribe(() => {
      // Pequeño delay para agrupar múltiples cambios
      setTimeout(() => {
        renderCart();
      }, 0);
    });
  }

  // Renderizar al cargar
  document.addEventListener('DOMContentLoaded', () => {
    renderCart();
    setupCartSubscription();
  });

  document.addEventListener('astro:page-load', () => {
    renderCart();
    setupCartSubscription();
  });
</script>
