---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/layout/TopBar.astro';
import Navbar from '../components/layout/Navbar.astro';
import CategoryMenu from '../components/layout/CategoryMenu.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import ProductCard from '../components/features/products/ProductCard.astro';
import { productsApi } from '../lib/api';

// Cargar productos desde la API
const allProducts = await productsApi.getAll({ limit: 12 });

// Convertir a formato compatible con ProductCard
const featuredProducts = allProducts.map(product => ({
  id: product.id.toString(),
  name: product.name,
  description: product.description || '',
  price: product.price,
  image: product.image_url || '',
  inStock: product.stock > 0,
  category: product.category || 'Sin categoría',
  brand: product.brand || ''
}));
---

<Layout title="Provifood - Distribuidora de Alimentos al Por Mayor y Menor">
  <!-- Barra superior -->
  <TopBar />
  
  <!-- Navegación principal -->
  <Navbar />
  
  <!-- Menú de categorías -->
  <CategoryMenu />
  
  <!-- Hero Section -->
  <section class="bg-provifood-primary text-white">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Contenido -->
        <div>
          <div class="inline-flex items-center space-x-2 bg-provifood-secondary px-4 py-2 rounded-full text-sm font-bold mb-6">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd" />
            </svg>
            <span class="text-white">Distribuidora de Alimentos</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-bold mb-5 leading-tight text-white">
            Abastecemos tu Negocio con Productos de Primera Calidad
          </h1>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed">
            Venta al por mayor y menor de HARINAS, ACEITES, PASTAS, LEGUMBRES Y MÁS. Precios especiales para empresas registradas.
          </p>
          
          <!-- CTA Buttons -->
          <div class="flex flex-wrap gap-4 mb-8">
            <Button href="/productos" variant="secondary" size="lg">
              Ver Productos
            </Button>
          </div>
          
          <!-- Features rápidas -->
          <div class="grid grid-cols-2 gap-4 pt-6 border-t border-white/20">
            <div class="flex items-center space-x-2">
              <svg class="w-5 h-5 text-provifood-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm text-white">Envío Gratis +$50.000</span>
            </div>
            <div class="flex items-center space-x-2">
              <svg class="w-5 h-5 text-provifood-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm text-white">Precios Mayoristas</span>
            </div>
          </div>
        </div>
        
        <!-- Imagen/Ilustración - Carrusel -->
        <div class="hidden md:block">
          <div class="relative group">
            <div class="bg-white/10 backdrop-blur-md rounded-3xl p-6 border border-white/20 shadow-2xl relative overflow-hidden">
              <!-- Efecto de brillo de fondo -->
              <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent pointer-events-none"></div>
              
              <div class="carousel-container relative h-80">
                {[1, 2, 3, 4].map((item, index) => (
                  <div 
                    class={`carousel-slide absolute top-0 left-0 w-full h-full transition-all duration-1000 ease-in-out ${index === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-95'}`}
                    data-slide={index}
                  >
                    <div class="bg-white rounded-2xl p-10 shadow-2xl h-full flex items-center justify-center relative overflow-hidden">
                      <!-- Placeholder para imagen de producto -->
                      <div class="w-full h-full bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl flex items-center justify-center">
                        <div class="text-center">
                          <svg class="w-40 h-40 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                          <p class="text-gray-400 text-sm">Imagen de producto {item}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              
              <!-- Botones de navegación -->
              <button 
                class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/90 hover:bg-white rounded-full shadow-lg flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 hover:scale-110 z-10"
                aria-label="Anterior"
              >
                <svg class="w-6 h-6 text-provifood-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              
              <button 
                class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/90 hover:bg-white rounded-full shadow-lg flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 hover:scale-110 z-10"
                aria-label="Siguiente"
              >
                <svg class="w-6 h-6 text-provifood-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </button>
              
              <!-- Indicadores del carrusel mejorados -->
              <div class="flex justify-center items-center space-x-3 mt-6">
                {[0, 1, 2, 3].map((index) => (
                  <button 
                    class={`carousel-indicator h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-white w-10 shadow-lg' : 'bg-white/40 w-2.5 hover:bg-white/60 hover:w-6'}`}
                    data-index={index}
                    aria-label={`Ir a la imagen ${index + 1}`}
                  ></button>
                ))}
              </div>
            </div>
          </div>
        </div>
        
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const slides = document.querySelectorAll('.carousel-slide');
            const indicators = document.querySelectorAll('.carousel-indicator');
            const prevBtn = document.querySelector('.carousel-prev');
            const nextBtn = document.querySelector('.carousel-next');
            let currentSlide = 0;
            const totalSlides = slides.length;
            let autoplayInterval;

            function showSlide(index) {
              slides.forEach((slide, i) => {
                if (i === index) {
                  slide.classList.add('opacity-100', 'scale-100');
                  slide.classList.remove('opacity-0', 'scale-95');
                } else {
                  slide.classList.remove('opacity-100', 'scale-100');
                  slide.classList.add('opacity-0', 'scale-95');
                }
              });
              
              indicators.forEach((indicator, i) => {
                if (i === index) {
                  indicator.classList.add('bg-white', 'w-10', 'shadow-lg');
                  indicator.classList.remove('bg-white/40', 'w-2.5');
                } else {
                  indicator.classList.remove('bg-white', 'w-10', 'shadow-lg');
                  indicator.classList.add('bg-white/40', 'w-2.5');
                }
              });
            }

            function nextSlide() {
              currentSlide = (currentSlide + 1) % totalSlides;
              showSlide(currentSlide);
            }

            function prevSlide() {
              currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
              showSlide(currentSlide);
            }

            function startAutoplay() {
              autoplayInterval = setInterval(nextSlide, 4000);
            }

            function stopAutoplay() {
              clearInterval(autoplayInterval);
            }

            // Botones de navegación
            if (prevBtn) {
              prevBtn.addEventListener('click', () => {
                prevSlide();
                stopAutoplay();
                startAutoplay();
              });
            }

            if (nextBtn) {
              nextBtn.addEventListener('click', () => {
                nextSlide();
                stopAutoplay();
                startAutoplay();
              });
            }

            // Indicadores clicables
            indicators.forEach((indicator, index) => {
              indicator.addEventListener('click', () => {
                currentSlide = index;
                showSlide(currentSlide);
                stopAutoplay();
                startAutoplay();
              });
            });

            // Pausar al hacer hover
            const carouselContainer = document.querySelector('.carousel-container');
            if (carouselContainer) {
              carouselContainer.addEventListener('mouseenter', stopAutoplay);
              carouselContainer.addEventListener('mouseleave', startAutoplay);
            }

            // Iniciar autoplay
            startAutoplay();
          });
        </script>
      </div>
    </div>
  </section>
  
  <!-- Sección de características -->
  <section class="py-8 bg-white border-y border-gray-200">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="flex items-center space-x-3 p-3">
          <div class="w-12 h-12 bg-provifood-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-provifood-dark text-sm">Calidad Garantizada</h3>
            <p class="text-xs text-provifood-gray">Productos certificados</p>
          </div>
        </div>
        
        <div class="flex items-center space-x-3 p-3">
          <div class="w-12 h-12 bg-provifood-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-provifood-dark text-sm">Entrega Rápida</h3>
            <p class="text-xs text-provifood-gray">24-48 horas hábiles</p>
          </div>
        </div>
        
        <div class="flex items-center space-x-3 p-3">
          <div class="w-12 h-12 bg-provifood-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-provifood-dark text-sm">Precios Mayoristas</h3>
            <p class="text-xs text-provifood-gray">Descuentos por volumen</p>
          </div>
        </div>
        
        <div class="flex items-center space-x-3 p-3">
          <div class="w-12 h-12 bg-provifood-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-provifood-dark text-sm">Atención Comercial</h3>
            <p class="text-xs text-provifood-gray">Asesoría personalizada</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Sección de productos destacados -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between mb-10">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-provifood-dark mb-2">Productos Destacados</h2>
          <p class="text-provifood-gray text-base">Los más vendidos de la semana</p>
        </div>
        <a href="/productos" class="hidden md:inline-flex items-center text-provifood-primary hover:text-provifood-secondary font-semibold">
          Ver Todos
          <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>
  
  <!-- Sección de categorías principales -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-provifood-dark mb-10 text-center">Compra por Categoría</h2>
      
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-6">
        <a href="/categoria/harinas" class="group bg-gradient-to-br from-amber-50 to-amber-100 rounded-xl p-8 hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-10 h-10 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="font-bold text-center text-provifood-dark text-lg">Harinas</h3>
          <p class="text-xs text-center text-provifood-gray mt-1">y Panificación</p>
        </a>
        
        <a href="/categoria/aceites" class="group bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-xl p-8 hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-10 h-10 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
