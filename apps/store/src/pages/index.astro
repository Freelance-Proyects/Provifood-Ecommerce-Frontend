---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/layout/TopBar.astro';
import Navbar from '../components/layout/Navbar.astro';
import CategoryMenu from '../components/layout/CategoryMenu.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import ProductCard from '../components/features/products/ProductCard.astro';

// Productos de ejemplo
const featuredProducts = [
  {
    id: '1',
    name: 'Harina 000 x 1kg',
    description: 'Harina de trigo fortificada, ideal para panificación',
    price: 450,
    image: '',
    inStock: true,
    quantity: '1kg',
    category: 'Harinas'
  },
  {
    id: '2',
    name: 'Aceite de Girasol x 1.5L',
    description: 'Aceite de girasol alto oleico, 100% puro',
    price: 1200,
    discount: 15,
    image: '',
    inStock: true,
    quantity: '1.5L',
    category: 'Aceites'
  },
  {
    id: '3',
    name: 'Fideos Mostachol x 500g',
    description: 'Pasta de sémola de trigo, cocción perfecta',
    price: 320,
    image: '',
    inStock: true,
    quantity: '500g',
    category: 'Pastas'
  },
  {
    id: '4',
    name: 'Arroz Largo Fino x 1kg',
    description: 'Arroz grano largo, ideal para todo tipo de comidas',
    price: 580,
    image: '',
    inStock: false,
    quantity: '1kg',
    category: 'Arroz'
  },
  {
    id: '5',
    name: 'Azúcar Blanca x 1kg',
    description: 'Azúcar refinada tipo A, máxima pureza',
    price: 420,
    image: '',
    inStock: true,
    quantity: '1kg',
    category: 'Azúcar'
  },
  {
    id: '6',
    name: 'Conserva de Tomate x 500g',
    description: 'Tomate perita en cubos, sin conservantes',
    price: 280,
    discount: 10,
    image: '',
    inStock: true,
    quantity: '500g',
    category: 'Conservas'
  },
];
---

<Layout title="Provifood - Distribuidora de Alimentos al Por Mayor y Menor">
  <!-- Barra superior -->
  <TopBar />
  
  <!-- Navegación principal -->
  <Navbar />
  
  <!-- Menú de categorías -->
  <CategoryMenu />
  
  <!-- Hero Section -->
  <section class="bg-provifood-primary text-white">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Contenido -->
        <div>
          <div class="inline-flex items-center space-x-2 bg-provifood-secondary px-4 py-2 rounded-full text-sm font-bold mb-6">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd" />
            </svg>
            <span class="text-white">Distribuidora de Alimentos</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-bold mb-5 leading-tight text-white">
            Abastecemos tu Negocio con Productos de Primera Calidad
          </h1>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed">
            Venta al por mayor y menor de HARINAS, ACEITES, PASTAS, LEGUMBRES Y MÁS. Precios especiales para empresas registradas.
          </p>
          
          <!-- CTA Buttons -->
          <div class="flex flex-wrap gap-4 mb-8">
            <Button href="/productos" variant="secondary" size="lg">
              Ver Productos
            </Button>
            <button class="inline-flex items-center justify-center px-8 py-4 bg-white text-provifood-primary font-bold rounded-provifood hover:bg-gray-100 transition-colors text-base">
              Registro Empresarial
            </button>
          </div>
          
          <!-- Features rápidas -->
          <div class="grid grid-cols-2 gap-4 pt-6 border-t border-white/20">
            <div class="flex items-center space-x-2">
              <svg class="w-5 h-5 text-provifood-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm text-white">Envío Gratis +$50.000</span>
            </div>
            <div class="flex items-center space-x-2">
              <svg class="w-5 h-5 text-provifood-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm text-white">Precios Mayoristas</span>
            </div>
          </div>
        </div>
        
        <!-- Imagen/Ilustración -->
        <div class="hidden md:block">
          <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-8 border border-white/10">
            <div class="grid grid-cols-2 gap-4">
              {[1, 2, 3, 4].map(() => (
                <div class="bg-white rounded-xl p-6 shadow-lg">
                  <div class="w-full h-28 bg-gray-100 rounded-lg flex items-center justify-center mb-3">
                    <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  </div>
                  <div class="h-2 bg-gray-200 rounded mb-2"></div>
                  <div class="h-2 bg-gray-200 rounded w-2/3"></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Sección de características -->
  <section class="py-8 bg-white border-y border-gray-200">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="flex items-center space-x-3 p-3">
          <div class="w-12 h-12 bg-provifood-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-provifood-dark text-sm">Calidad Garantizada</h3>
            <p class="text-xs text-provifood-gray">Productos certificados</p>
          </div>
        </div>
        
        <div class="flex items-center space-x-3 p-3">
          <div class="w-12 h-12 bg-provifood-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-provifood-dark text-sm">Entrega Rápida</h3>
            <p class="text-xs text-provifood-gray">24-48 horas hábiles</p>
          </div>
        </div>
        
        <div class="flex items-center space-x-3 p-3">
          <div class="w-12 h-12 bg-provifood-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-provifood-dark text-sm">Precios Mayoristas</h3>
            <p class="text-xs text-provifood-gray">Descuentos por volumen</p>
          </div>
        </div>
        
        <div class="flex items-center space-x-3 p-3">
          <div class="w-12 h-12 bg-provifood-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-provifood-dark text-sm">Atención Comercial</h3>
            <p class="text-xs text-provifood-gray">Asesoría personalizada</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Sección de productos destacados -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between mb-10">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-provifood-dark mb-2">Productos Destacados</h2>
          <p class="text-provifood-gray text-base">Los más vendidos de la semana</p>
        </div>
        <a href="/productos" class="hidden md:inline-flex items-center text-provifood-primary hover:text-provifood-secondary font-semibold">
          Ver Todos
          <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>
  
  <!-- Sección de categorías principales -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-provifood-dark mb-10 text-center">Compra por Categoría</h2>
      
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-6">
        <a href="/categoria/harinas" class="group bg-gradient-to-br from-amber-50 to-amber-100 rounded-xl p-8 hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-10 h-10 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="font-bold text-center text-provifood-dark text-lg">Harinas</h3>
          <p class="text-xs text-center text-provifood-gray mt-1">y Panificación</p>
        </a>
        
        <a href="/categoria/aceites" class="group bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-xl p-8 hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-10 h-10 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="font-bold text-center text-provifood-dark text-lg">Aceites</h3>
          <p class="text-xs text-center text-provifood-gray mt-1">y Grasas</p>
        </a>
        
        <a href="/categoria/pastas" class="group bg-gradient-to-br from-orange-50 to-orange-100 rounded-xl p-8 hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-10 h-10 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-bold text-center text-provifood-dark text-lg">Pastas</h3>
          <p class="text-xs text-center text-provifood-gray mt-1">y Fideos</p>
        </a>
        
        <a href="/categoria/arroz" class="group bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-8 hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="font-bold text-center text-provifood-dark text-lg">Arroz</h3>
          <p class="text-xs text-center text-provifood-gray mt-1">y Legumbres</p>
        </a>
      </div>
    </div>
  </section>
  
  <!-- Call to Action B2B -->
  <section class="bg-provifood-primary text-white py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center space-x-2 bg-provifood-secondary px-4 py-2 rounded-full text-sm font-bold mb-6">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <span class="text-white">Soluciones B2B</span>
        </div>
        
        <h2 class="text-3xl md:text-5xl font-bold mb-5 text-white">¿Necesitas un Presupuesto Personalizado?</h2>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          Nuestro equipo comercial está listo para ayudarte a encontrar los mejores productos y precios para tu negocio
        </p>
        
        <!-- Beneficios B2B -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 max-w-3xl mx-auto">
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
            <div class="w-12 h-12 bg-provifood-secondary rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-bold text-white text-lg mb-2">Precios Mayoristas</h3>
            <p class="text-sm text-white/80">Descuentos especiales por volumen</p>
          </div>
          
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
            <div class="w-12 h-12 bg-provifood-secondary rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <h3 class="font-bold text-white text-lg mb-2">Asesoría Personalizada</h3>
            <p class="text-sm text-white/80">Ejecutivo dedicado a tu cuenta</p>
          </div>
          
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
            <div class="w-12 h-12 bg-provifood-secondary rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-bold text-white text-lg mb-2">Entrega Programada</h3>
            <p class="text-sm text-white/80">Despachos según tus necesidades</p>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/contacto" variant="secondary" size="lg">
            Solicitar Presupuesto
          </Button>
          <a href="tel:+1234567890" class="inline-flex items-center justify-center space-x-2 px-8 py-4 bg-white text-provifood-primary font-semibold rounded-provifood hover:bg-gray-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Llamar Ahora</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Trama decorativa -->
  <div class="w-full h-16" style="background-image: url('/banner.png'); background-repeat: repeat-x; background-size: auto 100%; background-position: center;">
  </div>
  
  <!-- Footer -->
  <Footer />
</Layout>
