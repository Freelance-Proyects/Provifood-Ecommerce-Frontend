---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/layout/TopBar.astro';
import Navbar from '../../components/layout/Navbar.astro';
import CategoryMenu from '../../components/layout/CategoryMenu.astro';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/ui/Button.astro';
import ProductCard from '../../components/features/products/ProductCard.astro';
import { productsApi } from '../../lib/api';

const { id } = Astro.params;

// Obtener el producto
let product;
let relatedProducts = [];
let error = null;

try {
  product = await productsApi.getById(id);

  // Obtener productos relacionados de la misma categoría
  if (product?.category) {
    const allProducts = await productsApi.getAll({
      category: product.category,
      limit: 4
    });
    relatedProducts = allProducts.filter(p => p.id !== product.id).slice(0, 4);
  }
} catch (e) {
  error = 'Producto no encontrado';
  console.error(e);
}

if (!product) {
  return Astro.redirect('/404');
}

const price = product.price || 0;
const isInStock = (product.stock ?? 0) > 0;
const stockLevel = product.stock || 0;
---

<Layout title={product.name + ' - Provifood'}>
  <TopBar />
  <Navbar />
  <CategoryMenu />

  <!-- Breadcrumbs -->
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="container mx-auto px-4 py-3">
      <nav class="flex items-center space-x-2 text-sm">
        <a href="/" class="text-provifood-gray hover:text-provifood-primary">Inicio</a>
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a href="/productos" class="text-provifood-gray hover:text-provifood-primary">Productos</a>
        {product.category && (
          <>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <a href={'/categoria/' + product.category.toLowerCase()} class="text-provifood-gray hover:text-provifood-primary capitalize">
              {product.category}
            </a>
          </>
        )}
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-provifood-dark font-medium truncate max-w-xs">{product.name}</span>
      </nav>
    </div>
  </div>

  <!-- Contenido del producto -->
  <section class="py-8 md:py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

        <!-- Galería de imágenes -->
        <div class="space-y-4">
          <!-- Imagen principal -->
          <div class="bg-white border-2 border-gray-200 rounded-xl overflow-hidden aspect-square flex items-center justify-center p-8">
            {product.image_url && (
              <img
                src={product.image_url}
                alt={product.name}
                class="max-w-full max-h-full object-contain"
                id="main-image"
              />
            )}
            {!product.image_url && (
              <div class="w-full h-full flex items-center justify-center bg-gray-50">
                <svg class="w-32 h-32 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            )}
          </div>

          {!isInStock && (
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-center">
              <p class="text-red-800 font-semibold">Producto agotado</p>
              <p class="text-red-600 text-sm mt-1">Notifícame cuando esté disponible</p>
            </div>
          )}
        </div>

        <!-- Información del producto -->
        <div class="space-y-6">
          <!-- Marca -->
          {product.brand && (
            <div>
              <span class="text-sm text-gray-500 uppercase tracking-wide">{product.brand}</span>
            </div>
          )}

          <!-- Nombre -->
          <h1 class="text-3xl md:text-4xl font-bold text-provifood-dark leading-tight">
            {product.name}
          </h1>

          <!-- Categoría -->
          {product.category && (
            <div class="flex items-center space-x-2">
              <svg class="w-5 h-5 text-provifood-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              <a href={`/categoria/${product.category.toLowerCase()}`} class="text-provifood-primary hover:text-provifood-secondary font-medium capitalize">
                {product.category}
              </a>
            </div>
          )}

          <!-- Descripción -->
          {product.description && (
            <div class="prose prose-sm max-w-none">
              <p class="text-provifood-gray leading-relaxed">
                {product.description}
              </p>
            </div>
          )}

          <!-- Precio y Stock -->
          <div class="bg-gray-50 rounded-xl p-6 space-y-4">
            <div class="flex items-baseline justify-between">
              <div>
                <p class="text-sm text-gray-500 mb-1">Precio</p>
                <p class="text-4xl font-bold text-provifood-primary">
                  ${price.toLocaleString('es-CL')}
                </p>
              </div>

              {isInStock && (
                <div class="text-right">
                  <p class="text-sm text-gray-500 mb-1">Disponibilidad</p>
                  <p class={(stockLevel <= 5 ? 'text-orange-600' : 'text-green-600') + ' font-semibold'}>
                    {stockLevel <= 5 ? 'Solo quedan ' + stockLevel : 'En Stock'}
                  </p>
                </div>
              )}
            </div>
          </div>

          <!-- Selector de cantidad y agregar al carrito -->
          <div class="space-y-4">
            <div class="flex items-center space-x-4">
              <label class="text-sm font-medium text-provifood-dark">Cantidad:</label>
              <div class="flex items-center border-2 border-gray-300 rounded-lg">
                <button
                  id="decrease-qty"
                  class="px-4 py-2 hover:bg-gray-100 transition-colors"
                  aria-label="Disminuir cantidad"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                  </svg>
                </button>
                <input
                  type="number"
                  id="quantity"
                  value="1"
                  min="1"
                  max={stockLevel}
                  class="w-16 text-center border-x-2 border-gray-300 py-2 focus:outline-none"
                />
                <button
                  id="increase-qty"
                  class="px-4 py-2 hover:bg-gray-100 transition-colors"
                  aria-label="Aumentar cantidad"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
              </div>
            </div>

            <button
              id="add-to-cart"
              class="w-full bg-provifood-secondary hover:bg-orange-600 text-white font-bold py-4 px-6 rounded-lg disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors text-lg flex items-center justify-center space-x-2"
              disabled={!isInStock}
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-price={price}
              data-product-image={product.image_url}
              data-stock={stockLevel}
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <span>{isInStock ? 'Agregar al Carrito' : 'Producto Agotado'}</span>
            </button>

            <div class="flex space-x-4">
              <button class="flex-1 border-2 border-provifood-primary text-provifood-primary hover:bg-provifood-primary hover:text-white font-semibold py-3 px-4 rounded-lg transition-colors flex items-center justify-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span>Agregar a Favoritos</span>
              </button>
            </div>
          </div>

          <!-- Características adicionales -->
          <div class="border-t border-gray-200 pt-6 space-y-4">
            <h3 class="font-semibold text-provifood-dark text-lg">Información adicional</h3>
            <div class="grid grid-cols-2 gap-4">
              <div class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-provifood-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="font-medium text-sm">Envío Gratis</p>
                  <p class="text-xs text-gray-500">En compras +$50.000</p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-provifood-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <div>
                  <p class="font-medium text-sm">Calidad Garantizada</p>
                  <p class="text-xs text-gray-500">Productos certificados</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Productos relacionados -->
  {relatedProducts.length > 0 && (
    <section class="py-12 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-provifood-dark mb-8">También te puede interesar</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          {relatedProducts.map((relatedProduct) => (
            <ProductCard product={relatedProduct} />
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</Layout>

<script>
  // Manejo de cantidad
  const decreaseBtn = document.getElementById('decrease-qty');
  const increaseBtn = document.getElementById('increase-qty');
  const quantityInput = document.getElementById('quantity') as HTMLInputElement;
  const addToCartBtn = document.getElementById('add-to-cart');

  if (decreaseBtn && increaseBtn && quantityInput) {
    decreaseBtn.addEventListener('click', () => {
      const currentValue = parseInt(quantityInput.value);
      if (currentValue > 1) {
        quantityInput.value = String(currentValue - 1);
      }
    });

    increaseBtn.addEventListener('click', () => {
      const currentValue = parseInt(quantityInput.value);
      const maxValue = parseInt(quantityInput.max);

      // Obtener carrito y verificar cantidad disponible real
      const cart = JSON.parse(localStorage.getItem('provifood-cart') || '[]');
      const productId = addToCartBtn?.dataset.productId;
      const existingItem = cart.find((item: any) => item.id === productId);
      const quantityInCart = existingItem?.quantity || 0;
      const availableStock = maxValue - quantityInCart;

      if (currentValue >= availableStock) {
        const units = availableStock !== 1 ? 'es' : '';
        alert('⚠️ Stock limitado\n\nSolo puedes agregar ' + availableStock + ' unidad' + units + ' más.\nYa tienes ' + quantityInCart + ' en tu carrito.');
        quantityInput.value = String(Math.min(currentValue, availableStock));
        return;
      }

      if (currentValue < maxValue) {
        quantityInput.value = String(currentValue + 1);
      }
    });

    // Validar input manual
    quantityInput.addEventListener('change', () => {
      const currentValue = parseInt(quantityInput.value) || 1;
      const minValue = parseInt(quantityInput.min) || 1;
      const maxValue = parseInt(quantityInput.max);

      if (currentValue < minValue) {
        quantityInput.value = String(minValue);
      } else if (currentValue > maxValue) {
        quantityInput.value = String(maxValue);
        alert('⚠️ Stock limitado\n\nSolo hay ' + maxValue + ' unidades disponibles.');
      }
    });
  }

  // Agregar al carrito con validación de stock
  if (addToCartBtn) {
    addToCartBtn.addEventListener('click', () => {
      const quantity = parseInt(quantityInput?.value || '1');
      const productData = {
        id: addToCartBtn.dataset.productId,
        name: addToCartBtn.dataset.productName,
        price: parseFloat(addToCartBtn.dataset.productPrice || '0'),
        image: addToCartBtn.dataset.productImage,
        stock: parseInt(addToCartBtn.dataset.stock || '0'),
        quantity: quantity
      };

      // Obtener carrito actual del localStorage
      const cart = JSON.parse(localStorage.getItem('provifood-cart') || '[]');

      // Verificar si el producto ya está en el carrito
      const existingItemIndex = cart.findIndex((item: any) => item.id === productData.id);

      if (existingItemIndex > -1) {
        // Verificar stock antes de actualizar cantidad
        const currentQuantity = cart[existingItemIndex].quantity || 0;
        const newQuantity = currentQuantity + quantity;

        if (newQuantity > productData.stock) {
          const availableToAdd = productData.stock - currentQuantity;
          if (availableToAdd <= 0) {
            const units = currentQuantity !== 1 ? 'es' : '';
            alert('⚠️ Stock insuficiente\n\nYa tienes ' + currentQuantity + ' unidad' + units + ' de ' + productData.name + ' en tu carrito.\nNo hay stock adicional disponible.');
            return;
          }
          alert('⚠️ Stock insuficiente\n\nSolo hay ' + productData.stock + ' unidades disponibles.\nYa tienes ' + currentQuantity + ' en tu carrito.\nSolo puedes agregar ' + availableToAdd + ' más.');
          return;
        }

        // Actualizar cantidad
        cart[existingItemIndex].quantity = newQuantity;
      } else {
        // Verificar stock del nuevo producto
        if (quantity > productData.stock) {
          alert('⚠️ Stock insuficiente\n\nSolo hay ' + productData.stock + ' unidades disponibles de ' + productData.name + '.');
          return;
        }

        // Agregar nuevo producto
        cart.push(productData);
      }

      // Guardar en localStorage
      localStorage.setItem('provifood-cart', JSON.stringify(cart));

      // Mostrar confirmación
      const totalInCart = cart.find((item: any) => item.id === productData.id)?.quantity || 0;
      const quantityUnits = quantity > 1 ? 'es' : '';
      const addedForm = quantity > 1 ? 's' : '';
      const totalUnits = totalInCart > 1 ? 'es' : '';
      alert('✅ ' + productData.name + ' agregado al carrito\n\n' + quantity + ' unidad' + quantityUnits + ' agregada' + addedForm + '.\nTotal en carrito: ' + totalInCart + ' unidad' + totalUnits + '.');

      // Actualizar contador del carrito
      window.dispatchEvent(new Event('cart-updated'));

      // Resetear cantidad a 1
      if (quantityInput) {
        quantityInput.value = '1';
      }
    });
  }
</script>
