---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/layout/TopBar.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Error - Provifood">
  <TopBar />
  <Navbar />
  
  <!-- Página de Error Genérico -->
  <section class="min-h-screen bg-gradient-to-b from-gray-50 to-white py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <!-- Icono de error -->
        <div class="mb-8 flex justify-center">
          <div class="w-32 h-32 bg-red-100 rounded-full flex items-center justify-center">
            <svg class="w-16 h-16 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
        </div>
        
        <!-- Mensaje -->
        <h2 class="text-3xl md:text-4xl font-bold text-provifood-dark mb-4">
          ¡Algo salió mal!
        </h2>
        <p class="text-lg text-provifood-gray mb-8 max-w-md mx-auto">
          Ha ocurrido un error inesperado. Nuestro equipo ya está trabajando en solucionarlo. Por favor, intenta nuevamente más tarde.
        </p>
        
        <!-- Botones de acción -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <Button href="/" variant="primary" size="lg">
            Volver al Inicio
          </Button>
          <button 
            onclick="window.location.reload()" 
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-provifood-primary text-provifood-primary font-semibold rounded-provifood hover:bg-provifood-primary hover:text-white transition-all"
          >
            Recargar Página
          </button>
        </div>
        
        <!-- Información de contacto -->
        <div class="bg-amber-50 rounded-xl p-6 border border-amber-200">
          <p class="text-sm text-provifood-dark mb-2 font-semibold">
            ¿Necesitas ayuda inmediata?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center text-sm">
            <a href="tel:+1234567890" class="flex items-center space-x-2 text-provifood-primary hover:text-provifood-secondary transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>+123 456 7890</span>
            </a>
            <span class="text-gray-300 hidden sm:block">|</span>
            <a href="mailto:info@provifood.com" class="flex items-center space-x-2 text-provifood-primary hover:text-provifood-secondary transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>info@provifood.com</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>
