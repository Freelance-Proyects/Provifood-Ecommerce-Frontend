---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/layout/TopBar.astro';
import Navbar from '../components/layout/Navbar.astro';
import CategoryMenu from '../components/layout/CategoryMenu.astro';
import Footer from '../components/layout/Footer.astro';
import ProductCard from '../components/features/products/ProductCard.astro';
import { productsApi } from '../lib/api';

// Cargar todos los productos desde la API
const allProducts = await productsApi.getAll({ limit: 100 });

// Convertir a formato compatible con ProductCard
const products = allProducts.map(product => ({
  id: product.id.toString(),
  name: product.name,
  description: product.description || '',
  price: product.price,
  image: product.image_url || '',
  inStock: product.stock > 0,
  category: product.category || 'Sin categoría',
  brand: product.brand || ''
}));

// Calcular paginación dinámica
const productsPerPage = 100; // Mostrar hasta 100 productos por página
const totalPages = Math.ceil(products.length / productsPerPage);
const currentPage = 1;

// Obtener marcas únicas
const uniqueBrands = [...new Set(products.map(p => p.brand).filter(b => b))].sort();
---

<Layout title="Todos los Productos - Provifood">
  <TopBar />
  <Navbar />
  <CategoryMenu />
  
  <main class="bg-gray-50 min-h-screen">
    <!-- Banner Principal -->
    <section class="relative h-64 overflow-hidden bg-gradient-to-r from-provifood-primary to-teal-600">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="container mx-auto px-4 h-full flex items-center relative z-10">
        <div>
          <h1 class="text-4xl font-bold text-white mb-2">Todos los Productos</h1>
          <p class="text-xl text-white/90">Encuentra todo lo que necesitas para tu negocio</p>
        </div>
      </div>
    </section>

    <!-- Filtros de Categorías Rápidas -->
    <section class="bg-white border-b border-gray-200 py-6">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-4 overflow-x-auto pb-2">
          <button class="px-6 py-2 bg-provifood-primary text-white rounded-full font-semibold whitespace-nowrap hover:bg-provifood-primary/90 transition-colors">
            Todos
          </button>
          <a href="/categoria/frutas-verduras" class="px-6 py-2 bg-gray-100 text-provifood-dark rounded-full font-semibold whitespace-nowrap hover:bg-gray-200 transition-colors">
            Frutas y Verduras
          </a>
          <a href="/categoria/carnes-pescados" class="px-6 py-2 bg-gray-100 text-provifood-dark rounded-full font-semibold whitespace-nowrap hover:bg-gray-200 transition-colors">
            Carnes y Pescados
          </a>
          <a href="/categoria/lacteos" class="px-6 py-2 bg-gray-100 text-provifood-dark rounded-full font-semibold whitespace-nowrap hover:bg-gray-200 transition-colors">
            Lácteos
          </a>
          <a href="/categoria/panaderia" class="px-6 py-2 bg-gray-100 text-provifood-dark rounded-full font-semibold whitespace-nowrap hover:bg-gray-200 transition-colors">
            Panadería
          </a>
          <a href="/categoria/bebidas" class="px-6 py-2 bg-gray-100 text-provifood-dark rounded-full font-semibold whitespace-nowrap hover:bg-gray-200 transition-colors">
            Bebidas
          </a>
          <a href="/categoria/despensa" class="px-6 py-2 bg-gray-100 text-provifood-dark rounded-full font-semibold whitespace-nowrap hover:bg-gray-200 transition-colors">
            Despensa
          </a>
          <a href="/categoria/congelados" class="px-6 py-2 bg-gray-100 text-provifood-dark rounded-full font-semibold whitespace-nowrap hover:bg-gray-200 transition-colors">
            Congelados
          </a>
          <a href="/categoria/limpieza" class="px-6 py-2 bg-gray-100 text-provifood-dark rounded-full font-semibold whitespace-nowrap hover:bg-gray-200 transition-colors">
            Limpieza
          </a>
        </div>
      </div>
    </section>

    <!-- Contenido Principal -->
    <div class="container mx-auto px-4 py-8">
      <div class="flex gap-8">
        <!-- Sidebar de Filtros -->
        <aside class="hidden lg:block w-64 flex-shrink-0">
          <div class="bg-white rounded-lg shadow-sm sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto">
            <!-- Categorías -->
            <div class="p-4 border-b border-gray-200">
              <button class="flex items-center justify-between w-full text-left">
                <h3 class="font-bold text-provifood-dark">Categorías</h3>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="mt-3 space-y-2">
                {[
                  'Frutas y Verduras',
                  'Carnes y Pescados',
                  'Lácteos',
                  'Panadería',
                  'Bebidas',
                  'Despensa',
                  'Congelados',
                  'Limpieza'
                ].map((cat) => (
                  <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="checkbox" class="rounded text-provifood-primary focus:ring-provifood-primary filter-category" data-category={cat} />
                    <span class="text-sm text-provifood-gray">{cat}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Marcas -->
            <div class="p-4 border-b border-gray-200">
              <button class="flex items-center justify-between w-full text-left">
                <h3 class="font-bold text-provifood-dark">Marcas</h3>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="mt-3 space-y-2" id="brands-filter">
                {uniqueBrands.map((brand) => (
                  <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="checkbox" class="rounded text-provifood-primary focus:ring-provifood-primary filter-brand" data-brand={brand} />
                    <span class="text-sm text-provifood-gray">{brand}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Precio -->
            <div class="p-4 border-b border-gray-200">
              <button class="flex items-center justify-between w-full text-left">
                <h3 class="font-bold text-provifood-dark">Precio</h3>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="mt-3 space-y-3">
                <div class="flex items-center gap-2">
                  <input type="number" id="price-min" placeholder="Min" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                  <span class="text-gray-400">-</span>
                  <input type="number" id="price-max" placeholder="Max" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                </div>
                <button id="apply-price" class="w-full px-4 py-2 bg-provifood-primary text-white rounded-lg text-sm font-semibold hover:bg-provifood-primary/90 transition-colors">
                  Aplicar
                </button>
              </div>
            </div>

            <!-- Disponibilidad -->
            <div class="p-4 border-b border-gray-200">
              <button class="flex items-center justify-between w-full text-left">
                <h3 class="font-bold text-provifood-dark">Disponibilidad</h3>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="mt-3 space-y-2">
                <label class="flex items-center space-x-2 cursor-pointer">
                  <input type="checkbox" id="filter-in-stock" class="rounded text-provifood-primary focus:ring-provifood-primary" />
                  <span class="text-sm text-provifood-gray">En stock</span>
                </label>
                <label class="flex items-center space-x-2 cursor-pointer">
                  <input type="checkbox" id="filter-out-stock" class="rounded text-provifood-primary focus:ring-provifood-primary" />
                  <span class="text-sm text-provifood-gray">Sin stock</span>
                </label>
              </div>
            </div>

            <!-- Botón Aplicar Filtros -->
            <div class="p-4">
              <button id="apply-filters" class="w-full px-4 py-3 bg-provifood-primary text-white rounded-lg font-bold hover:bg-provifood-primary/90 transition-colors shadow-md">
                Aplicar Filtros
              </button>
            </div>
          </div>
        </aside>

        <!-- Grid de Productos -->
        <div class="flex-1">
          <!-- Barra de ordenamiento -->
          <div class="bg-white rounded-lg shadow-sm p-4 mb-6 flex items-center justify-between">
            <p class="text-provifood-gray">
              <span class="font-semibold text-provifood-dark" id="products-count">{products.length}</span> productos encontrados
            </p>
            <div class="flex items-center gap-3">
              <span class="text-sm text-provifood-gray">Ordenar por:</span>
              <select id="sort-select" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-semibold text-provifood-dark focus:ring-2 focus:ring-provifood-primary focus:border-transparent">
                <option value="default">Recomendados</option>
                <option value="price-asc">Menor precio</option>
                <option value="price-desc">Mayor precio</option>
                <option value="name">Nombre (A-Z)</option>
              </select>
            </div>
          </div>

          <!-- Grid de productos -->
          <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {products.map((product) => (
              <div 
                class="product-item" 
                data-brand={product.brand}
                data-price={product.price}
                data-category={product.category}
                data-in-stock={product.inStock ? 'true' : 'false'}
              >
                <ProductCard product={product} />
              </div>
            ))}
          </div>

          <!-- Paginación -->
          {totalPages > 1 && (
            <div class="mt-8 flex justify-center">
              <nav class="flex items-center gap-2">
                <button class="px-4 py-2 border border-gray-300 rounded-lg text-provifood-dark hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" disabled={currentPage === 1}>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>
                {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
                  <button class={`px-4 py-2 border rounded-lg font-semibold transition-colors ${page === currentPage ? 'bg-provifood-primary text-white border-provifood-primary' : 'border-gray-300 text-provifood-dark hover:bg-gray-50'}`}>
                    {page}
                  </button>
                ))}
                <button class="px-4 py-2 border border-gray-300 rounded-lg text-provifood-dark hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" disabled={currentPage === totalPages}>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </nav>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>

<script is:inline>
  // Función para filtrar productos
  function filterProducts() {
    const productItems = document.querySelectorAll('.product-item');
    const selectedBrands = Array.from(document.querySelectorAll('.filter-brand:checked')).map(cb => cb.dataset.brand);
    const selectedCategories = Array.from(document.querySelectorAll('.filter-category:checked')).map(cb => cb.dataset.category);
    const minPrice = parseFloat(document.getElementById('price-min').value) || 0;
    const maxPrice = parseFloat(document.getElementById('price-max').value) || Infinity;
    const showInStock = document.getElementById('filter-in-stock').checked;
    const showOutStock = document.getElementById('filter-out-stock').checked;
    
    let visibleCount = 0;
    
    productItems.forEach(item => {
      const brand = item.dataset.brand;
      const category = item.dataset.category;
      const price = parseFloat(item.dataset.price);
      const inStock = item.dataset.inStock === 'true';
      
      // Filtrar por marca (si no hay marcas seleccionadas, mostrar todas)
      const brandMatch = selectedBrands.length === 0 || selectedBrands.includes(brand);
      
      // Filtrar por categoría (si no hay categorías seleccionadas, mostrar todas)
      const categoryMatch = selectedCategories.length === 0 || selectedCategories.includes(category);
      
      // Filtrar por precio
      const priceMatch = price >= minPrice && price <= maxPrice;
      
      // Filtrar por disponibilidad (si ambos o ninguno están marcados, mostrar todos)
      let stockMatch = true;
      if (showInStock && !showOutStock) {
        stockMatch = inStock;
      } else if (!showInStock && showOutStock) {
        stockMatch = !inStock;
      }
      // Si ambos están marcados o ninguno, stockMatch = true (mostrar todos)
      
      if (brandMatch && categoryMatch && priceMatch && stockMatch) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });
    
    // Actualizar contador
    document.getElementById('products-count').textContent = visibleCount;
  }
  
  // Función para ordenar productos
  function sortProducts(sortBy) {
    const grid = document.getElementById('products-grid');
    const items = Array.from(grid.querySelectorAll('.product-item'));
    
    items.sort((a, b) => {
      const priceA = parseFloat(a.dataset.price);
      const priceB = parseFloat(b.dataset.price);
      const brandA = a.dataset.brand.toLowerCase();
      const brandB = b.dataset.brand.toLowerCase();
      
      switch(sortBy) {
        case 'price-asc':
          return priceA - priceB;
        case 'price-desc':
          return priceB - priceA;
        case 'name':
          return brandA.localeCompare(brandB);
        default:
          return 0;
      }
    });
    
    // Reordenar en el DOM
    items.forEach(item => grid.appendChild(item));
  }
  
  // Event listeners
  function initFilters() {
    // Botón Aplicar Filtros (aplica todos los filtros juntos)
    document.getElementById('apply-filters')?.addEventListener('click', filterProducts);
    
    // Botón aplicar precio (también aplica todos los filtros)
    document.getElementById('apply-price')?.addEventListener('click', filterProducts);
    
    // Ordenamiento (se aplica independientemente)
    document.getElementById('sort-select')?.addEventListener('change', (e) => {
      sortProducts(e.target.value);
    });
  }
  
  document.addEventListener('DOMContentLoaded', initFilters);
  document.addEventListener('astro:page-load', initFilters);
</script>
