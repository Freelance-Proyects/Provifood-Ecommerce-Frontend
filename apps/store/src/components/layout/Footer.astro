---
// Footer del sitio
---

<footer class="bg-provifood-primary text-white mt-16">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Columna 1: Logo y descripción -->
      <div class="col-span-1">
        <div class="mb-4">
          <img src="/logo.png" alt="Provifood" class="h-12 w-auto brightness-0 invert" />
        </div>
        <p class="text-sm text-gray-300 leading-relaxed">
          Tu proveedor confiable de alimentos de calidad. Comprometidos con la excelencia y el servicio.
        </p>
      </div>
      
      <!-- Columna 2: Enlaces rápidos -->
      <div>
        <h3 class="font-bold text-lg mb-4">Enlaces Rápidos</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-gray-300 hover:text-provifood-secondary transition-colors">Inicio</a></li>
          <li><a href="/productos" class="text-gray-300 hover:text-provifood-secondary transition-colors">Productos</a></li>
          <li><a href="/catalogo" class="text-gray-300 hover:text-provifood-secondary transition-colors">Catálogo 2024</a></li>
          <li><a href="/nosotros" class="text-gray-300 hover:text-provifood-secondary transition-colors">Nosotros</a></li>
        </ul>
      </div>
      
      <!-- Columna 3: Información -->
      <div>
        <h3 class="font-bold text-lg mb-4">Información</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/terminos" class="text-gray-300 hover:text-provifood-secondary transition-colors">Términos y Condiciones</a></li>
          <li><a href="/privacidad" class="text-gray-300 hover:text-provifood-secondary transition-colors">Política de Privacidad</a></li>
          <li><a href="/envios" class="text-gray-300 hover:text-provifood-secondary transition-colors">Envíos y Devoluciones</a></li>
          <li><a href="/faq" class="text-gray-300 hover:text-provifood-secondary transition-colors">Preguntas Frecuentes</a></li>
        </ul>
      </div>
      
      <!-- Columna 4: Contacto -->
      <div>
        <h3 class="font-bold text-lg mb-4">Contacto</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start space-x-2">
            <svg class="w-5 h-5 text-provifood-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-gray-300">Av. Principal 123, Ciudad</span>
          </li>
          <li class="flex items-start space-x-2">
            <svg class="w-5 h-5 text-provifood-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+1234567890" class="text-gray-300 hover:text-provifood-secondary transition-colors">+123 456 7890</a>
          </li>
          <li class="flex items-start space-x-2">
            <svg class="w-5 h-5 text-provifood-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@provifood.com" class="text-gray-300 hover:text-provifood-secondary transition-colors">info@provifood.com</a>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="border-t border-teal-700 mt-8 pt-8 text-center text-sm text-gray-300">
      <p>&copy; {new Date().getFullYear()} Provifood. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
