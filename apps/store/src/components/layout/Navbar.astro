---
// Barra de navegación principal con logo y buscador
---

<nav class="bg-white shadow-sm sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between py-4 gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 flex-shrink-0">
        <img src="/logo.png" alt="Provifood" class="h-16 w-auto" />
      </a>
      
      <!-- Buscador -->
      <div class="hidden md:flex flex-1 max-w-2xl">
        <div class="relative w-full">
          <input 
            type="search" 
            placeholder="Buscar productos, marcas..." 
            class="w-full px-4 py-2 pr-12 border-2 border-gray-300 rounded-lg focus:border-provifood-primary focus:outline-none"
          />
          <button class="absolute right-2 top-1/2 -translate-y-1/2 bg-provifood-secondary hover:bg-orange-600 text-white px-4 py-1.5 rounded transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Acciones de usuario -->
      <div class="flex items-center space-x-2 flex-shrink-0">
        <!-- Cuenta de usuario -->
        <a href="/login" class="hidden md:flex items-center space-x-1 px-3 py-2 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-5 h-5 text-provifood-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="text-sm font-semibold text-provifood-dark">Mi Cuenta</span>
        </a>
        
        <!-- Carrito -->
        <a href="/carrito" class="relative p-2 hover:bg-gray-100 rounded-lg transition-colors group">
          <svg class="w-6 h-6 text-provifood-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span class="absolute -top-1 -right-1 bg-provifood-secondary text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold">0</span>
          <span class="hidden md:inline absolute bottom-full right-0 mb-2 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Mi Carrito</span>
        </a>
        
        <!-- Menú móvil -->
        <button class="md:hidden p-2 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-6 h-6 text-provifood-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Barra de categorías -->
</nav>
