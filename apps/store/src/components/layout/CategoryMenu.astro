---
// Menú de categorías con desplegable tipo Jumbo
const categories = [
  { name: 'Frutas y Verduras', href: '/categoria/frutas-verduras' },
  { name: 'Carnes y Pescados', href: '/categoria/carnes-pescados' },
  { name: 'Lácteos', href: '/categoria/lacteos' },
  { name: 'Panadería', href: '/categoria/panaderia' },
  { name: 'Bebidas', href: '/categoria/bebidas' },
  { name: 'Despensa', href: '/categoria/despensa' },
  { name: 'Congelados', href: '/categoria/congelados' },
  { name: 'Limpieza', href: '/categoria/limpieza' },
];
---

<div class="bg-stone-50" id="category-menu">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between py-3">
      <!-- Botón desplegable de categorías -->
      <div class="relative" id="categories-dropdown">
        <button
          id="categories-btn"
          class="flex items-center space-x-2 px-4 py-2 bg-provifood-secondary text-white rounded hover:bg-orange-600 font-semibold"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span>Todas las Categorías</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        
        <!-- Menú desplegable -->
        <div 
          id="categories-menu"
          class="hidden absolute left-0 top-full mt-2 w-96 bg-white rounded-xl shadow-2xl border border-gray-100 z-50 overflow-hidden"
        >
          <div class="py-2">
            {categories.map((category, index) => (
              <a
                href={category.href}
                class="flex items-center justify-between px-5 py-3.5 text-provifood-dark hover:bg-gradient-to-r hover:from-provifood-primary/5 hover:to-teal-50 group border-b border-gray-50 last:border-b-0"
              >
                <div class="flex items-center space-x-3">
                  <div class="w-8 h-8 flex items-center justify-center">
                    <svg class="w-5 h-5 text-provifood-primary group-hover:text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  </div>
                  <span class="font-semibold text-sm group-hover:text-provifood-primary">{category.name}</span>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-provifood-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Enlaces adicionales -->
      <div class="hidden md:flex items-center space-x-6">
        <a href="https://provifood.cl/" target="_blank" rel="noopener noreferrer" class="text-provifood-dark hover:text-provifood-primary font-medium">
          Sobre Nosotros
        </a>
        <a href="/empresas" class="text-provifood-dark hover:text-provifood-primary font-medium">
          Empresas y Socios
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function initCategoryMenu() {
    const btn = document.getElementById('categories-btn');
    const menu = document.getElementById('categories-menu');
    
    if (btn && menu) {
      // Remover listeners previos si existen
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.classList.toggle('hidden');
      });
      
      // Cerrar al hacer click fuera
      const closeMenu = () => {
        menu.classList.add('hidden');
      };
      
      document.addEventListener('click', closeMenu);
      
      // Prevenir que el menú se cierre al hacer click dentro
      menu.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    }
  }
  
  // Ejecutar al cargar la página
  initCategoryMenu();
  
  // Ejecutar después de cada navegación con View Transitions
  document.addEventListener('astro:page-load', initCategoryMenu);
</script>
