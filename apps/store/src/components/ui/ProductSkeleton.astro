---
// Skeleton loader para tarjetas de productos
---

<div class="bg-white rounded-lg overflow-hidden border border-gray-200 h-full flex flex-col animate-pulse">
  <!-- Imagen skeleton -->
  <div class="relative bg-gray-200 h-48 md:h-56"></div>

  <!-- Información del producto -->
  <div class="p-3 md:p-4 flex-1 flex flex-col space-y-3">
    <!-- Marca -->
    <div class="h-3 bg-gray-200 rounded w-1/3"></div>

    <!-- Nombre del producto (2 líneas) -->
    <div class="space-y-2">
      <div class="h-4 bg-gray-300 rounded w-full"></div>
      <div class="h-4 bg-gray-300 rounded w-2/3"></div>
    </div>

    <!-- Spacer -->
    <div class="flex-1"></div>

    <!-- Precio -->
    <div class="h-6 bg-gray-300 rounded w-1/2"></div>

    <!-- Botón -->
    <div class="h-10 bg-gray-200 rounded w-full"></div>
  </div>
</div>

<style>
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
