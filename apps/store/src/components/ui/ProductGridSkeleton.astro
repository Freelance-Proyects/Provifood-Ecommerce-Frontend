---
import ProductSkeleton from './ProductSkeleton.astro';

interface Props {
  count?: number;
}

const { count = 8 } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
  {Array.from({ length: count }).map(() => (
    <ProductSkeleton />
  ))}
</div>
