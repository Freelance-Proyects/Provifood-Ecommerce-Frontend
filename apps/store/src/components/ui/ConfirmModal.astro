---
// Modal de confirmación para acciones destructivas
---

<div id="confirm-modal" class="fixed inset-0 z-[10000] hidden" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-message">
  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-opacity"></div>

  <!-- Modal -->
  <div class="relative min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full transform transition-all scale-100 opacity-100">
      <!-- Header -->
      <div id="confirm-header" class="px-6 pt-6 pb-4">
        <div class="flex items-start gap-4">
          <div id="confirm-icon" class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center" aria-hidden="true">
            <!-- Icon will be inserted dynamically -->
          </div>
          <div class="flex-1 min-w-0">
            <h3 id="confirm-title" class="text-xl font-bold text-provifood-dark mb-2"></h3>
            <p id="confirm-message" class="text-provifood-gray text-sm leading-relaxed"></p>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="px-6 pb-6 flex gap-3">
        <button
          id="confirm-cancel"
          class="flex-1 px-4 py-3 border-2 border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition-colors"
          aria-label="Cancelar acción"
        >
          Cancelar
        </button>
        <button
          id="confirm-accept"
          class="flex-1 px-4 py-3 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition-colors"
          aria-label="Confirmar acción"
        >
          Confirmar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  interface ConfirmOptions {
    title: string
    message: string
    confirmText?: string
    cancelText?: string
    type?: 'danger' | 'warning' | 'info'
  }

  let resolveConfirm: ((value: boolean) => void) | null = null
  let isModalInitialized = false
  let lastFocusedElement: HTMLElement | null = null

  // Named handler functions for proper cleanup
  const handleAcceptClick = () => hideConfirmModal(true)
  const handleCancelClick = () => hideConfirmModal(false)
  const handleOverlayClick = (e: MouseEvent) => {
    const modal = document.getElementById('confirm-modal')
    if (e.target === modal) {
      hideConfirmModal(false)
    }
  }
  const handleEscapeKey = (e: KeyboardEvent) => {
    const modal = document.getElementById('confirm-modal')
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      hideConfirmModal(false)
    }
  }

  function showConfirmModal(options: ConfirmOptions): Promise<boolean> {
    return new Promise((resolve) => {
      const modal = document.getElementById('confirm-modal')
      const title = document.getElementById('confirm-title')
      const message = document.getElementById('confirm-message')
      const icon = document.getElementById('confirm-icon')
      const acceptBtn = document.getElementById('confirm-accept') as HTMLButtonElement
      const cancelBtn = document.getElementById('confirm-cancel') as HTMLButtonElement

      if (!modal || !title || !message || !icon || !acceptBtn || !cancelBtn) {
        resolve(false)
        return
      }

      // Store currently focused element
      lastFocusedElement = document.activeElement as HTMLElement

      // Store the resolve function
      resolveConfirm = resolve

      // Set content
      title.textContent = options.title
      message.textContent = options.message
      acceptBtn.textContent = options.confirmText || 'Confirmar'
      cancelBtn.textContent = options.cancelText || 'Cancelar'

      // Update ARIA labels
      acceptBtn.setAttribute('aria-label', options.confirmText || 'Confirmar acción')
      cancelBtn.setAttribute('aria-label', options.cancelText || 'Cancelar acción')

      // Set icon and colors based on type
      const type = options.type || 'danger'
      if (type === 'danger') {
        icon.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center bg-red-100'
        icon.innerHTML = `
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        `
        acceptBtn.className = 'flex-1 px-4 py-3 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition-colors'
      } else if (type === 'warning') {
        icon.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center bg-orange-100'
        icon.innerHTML = `
          <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        `
        acceptBtn.className = 'flex-1 px-4 py-3 bg-orange-500 text-white font-semibold rounded-lg hover:bg-orange-600 transition-colors'
      } else {
        icon.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center bg-blue-100'
        icon.innerHTML = `
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        `
        acceptBtn.className = 'flex-1 px-4 py-3 bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition-colors'
      }

      // Show modal
      modal.classList.remove('hidden')

      // Prevent body scroll
      document.body.style.overflow = 'hidden'

      // Focus on cancel button for better accessibility
      setTimeout(() => cancelBtn.focus(), 100)
    })
  }

  function hideConfirmModal(confirmed: boolean) {
    const modal = document.getElementById('confirm-modal')
    if (modal) {
      modal.classList.add('hidden')
      document.body.style.overflow = ''
    }

    // Restore focus to previously focused element
    if (lastFocusedElement) {
      lastFocusedElement.focus()
      lastFocusedElement = null
    }

    if (resolveConfirm) {
      resolveConfirm(confirmed)
      resolveConfirm = null
    }
  }

  function initializeModalListeners() {
    // Prevent duplicate initialization
    if (isModalInitialized) return

    const acceptBtn = document.getElementById('confirm-accept')
    const cancelBtn = document.getElementById('confirm-cancel')
    const modal = document.getElementById('confirm-modal')

    if (acceptBtn) {
      acceptBtn.addEventListener('click', handleAcceptClick)
    }

    if (cancelBtn) {
      cancelBtn.addEventListener('click', handleCancelClick)
    }

    // Close on overlay click
    if (modal) {
      modal.addEventListener('click', handleOverlayClick)
    }

    // Close on Escape key
    document.addEventListener('keydown', handleEscapeKey)

    isModalInitialized = true
  }

  function cleanupModalListeners() {
    const acceptBtn = document.getElementById('confirm-accept')
    const cancelBtn = document.getElementById('confirm-cancel')
    const modal = document.getElementById('confirm-modal')

    if (acceptBtn) {
      acceptBtn.removeEventListener('click', handleAcceptClick)
    }

    if (cancelBtn) {
      cancelBtn.removeEventListener('click', handleCancelClick)
    }

    if (modal) {
      modal.removeEventListener('click', handleOverlayClick)
    }

    document.removeEventListener('keydown', handleEscapeKey)

    isModalInitialized = false
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', initializeModalListeners)

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', () => {
    cleanupModalListeners()
    initializeModalListeners()
  })

  // Cleanup before page unload
  document.addEventListener('astro:before-swap', cleanupModalListeners)

  // Export function globally with proper typing
  window.showConfirmModal = showConfirmModal
</script>
