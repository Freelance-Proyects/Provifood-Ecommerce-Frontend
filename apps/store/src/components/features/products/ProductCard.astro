---
// Tarjeta de producto para E-commerce
import type { Product } from '@provifood/types';

interface Props {
  product?: Partial<Product>;
  showWholesalePrice?: boolean;
}

const { 
  product = {
    name: 'Nombre del Producto',
    price: 0,
    image: '',
    inStock: true,
    category: 'Categoría',
    brand: '',
    discount: 0
  },
  showWholesalePrice = false 
} = Astro.props;

const regularPrice = product.price || 0;
const discount = product.discount || 0;
const discountedPrice = discount > 0 ? regularPrice * (1 - discount / 100) : regularPrice;
---

<div class="product-card bg-white rounded-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow duration-300 group relative">
  <!-- Imagen del producto -->
  <div class="relative bg-white h-56 overflow-hidden flex items-center justify-center p-6">
    {product.image ? (
      <img 
        src={product.image} 
        alt={product.name}
        loading="lazy"
        decoding="async"
        class="max-w-full max-h-full object-contain group-hover:scale-110 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gray-50 rounded-lg">
        <svg class="w-24 h-24 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
    
    {!product.inStock && (
      <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
        <span class="text-white text-lg font-bold">Agotado</span>
      </div>
    )}
  </div>
  
  <!-- Información del producto -->
  <div class="p-4">
    <!-- Marca (opacidad baja) -->
    {product.brand && (
      <p class="text-xs text-gray-400 mb-1 uppercase tracking-wide">
        {product.brand}
      </p>
    )}
    
    <!-- Nombre del producto (Texto Principal) -->
    <h3 class="text-base font-semibold text-provifood-dark mb-3 line-clamp-2 min-h-[3rem]">
      {product.name}
    </h3>
    
    <!-- Precio (tamaño notable) -->
    <div class="mb-4">
      <div class="flex items-baseline gap-2">
        <span class="text-2xl font-bold text-provifood-primary">
          ${discountedPrice.toLocaleString('es-CL')}
        </span>
        {discount > 0 && (
          <span class="text-base text-gray-400 line-through">
            ${regularPrice.toLocaleString('es-CL')}
          </span>
        )}
      </div>
    </div>
    
    <!-- Botón de agregar -->
    <button 
      class="w-full bg-provifood-secondary hover:bg-orange-600 text-white font-semibold py-3 px-4 rounded-lg transition-colors disabled:bg-gray-300 disabled:cursor-not-allowed"
      disabled={!product.inStock}
    >
      {product.inStock ? 'Agregar al Carrito' : 'Sin Stock'}
    </button>
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
