---
// Tarjeta de producto para E-commerce
import type { Product } from '@provifood/types';

interface Props {
  product?: Partial<Product>;
  showWholesalePrice?: boolean;
}

const { 
  product = {
    name: 'Nombre del Producto',
    price: 0,
    image: '',
    inStock: true,
    category: 'Categoría'
  },
  showWholesalePrice = false 
} = Astro.props;

const regularPrice = product.price || 0;
const discount = product.discount || 0;
const discountedPrice = discount > 0 ? regularPrice * (1 - discount / 100) : regularPrice;
const rating = (product as Product).rating || 4.5;
---

<div class="product-card bg-white rounded-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow duration-300 group relative">
  <!-- Botón favorito -->
  <button class="absolute top-3 right-3 z-10 w-10 h-10 bg-white rounded-full shadow-md flex items-center justify-center hover:bg-gray-50 transition-colors">
    <svg class="w-5 h-5 text-gray-400 hover:text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
    </svg>
  </button>

  <!-- Imagen del producto -->
  <div class="relative bg-white h-56 overflow-hidden flex items-center justify-center p-6">
    {product.image ? (
      <img 
        src={product.image} 
        alt={product.name} 
        class="max-w-full max-h-full object-contain group-hover:scale-110 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gray-50 rounded-lg">
        <svg class="w-24 h-24 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
    
    {!product.inStock && (
      <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
        <span class="text-white text-lg font-bold">Agotado</span>
      </div>
    )}
  </div>
  
  <!-- Información del producto -->
  <div class="p-4">
    <!-- Precio principal -->
    <div class="mb-2">
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-provifood-dark">
          ${discountedPrice.toLocaleString('es-CL')}
        </span>
        {discount > 0 && (
          <span class="text-lg text-gray-400 line-through">
            ${regularPrice.toLocaleString('es-CL')}
          </span>
        )}
      </div>
    </div>

    <!-- Categoría -->
    <p class="text-sm text-provifood-gray mb-2">
      {product.category}
    </p>
    
    <!-- Nombre del producto -->
    <h3 class="text-base text-provifood-dark mb-3 line-clamp-2 min-h-[3rem]">
      {product.name}
    </h3>
    
    <!-- Botón de agregar -->
    <button 
      class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors disabled:bg-gray-300 disabled:cursor-not-allowed"
      disabled={!product.inStock}
    >
      {product.inStock ? 'Agregar' : 'Sin Stock'}
    </button>

    <!-- Rating -->
    <div class="flex items-center gap-1 mt-3">
      <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
      <span class="text-provifood-dark font-semibold">{rating.toFixed(1)}</span>
    </div>
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
