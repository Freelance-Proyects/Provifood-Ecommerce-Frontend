---
// Tarjeta de producto para E-commerce
import type { Product } from '@provifood/types';

interface Props {
  product?: Partial<Product>;
  showWholesalePrice?: boolean;
}

const {
  product = {
    name: 'Nombre del Producto',
    price: 0,
    image_url: '',
    stock: 0,
    category: 'Categoría',
    brand: ''
  },
  showWholesalePrice = false
} = Astro.props;

const price = product.price || 0;
const isInStock = (product.stock ?? 0) > 0;
---

<a href={`/producto/${product.id}`} class="product-card bg-white rounded-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow group relative h-full flex flex-col">
  <!-- Imagen del producto -->
  <div class="relative bg-white h-48 md:h-56 overflow-hidden flex items-center justify-center p-4 md:p-6">
    {product.image_url ? (
      <img
        src={product.image_url}
        alt={product.name}
        loading="lazy"
        decoding="async"
        class="max-w-full max-h-full object-contain"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gray-50 rounded-lg">
        <svg class="w-20 h-20 md:w-24 md:h-24 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}

    {!isInStock && (
      <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
        <span class="text-white text-base md:text-lg font-bold">Agotado</span>
      </div>
    )}
  </div>

  <!-- Información del producto -->
  <div class="p-3 md:p-4 flex-1 flex flex-col">
    <!-- Marca (opacidad baja) -->
    {product.brand && (
      <p class="text-xs text-gray-400 mb-1 uppercase tracking-wide">
        {product.brand}
      </p>
    )}

    <!-- Nombre del producto (Texto Principal) -->
    <h3 class="text-sm md:text-base font-semibold text-provifood-dark mb-2 md:mb-3 line-clamp-2 flex-1">
      {product.name}
    </h3>

    <!-- Precio (tamaño notable) -->
    <div class="mb-3 md:mb-4">
      <div class="flex items-baseline gap-2">
        <span class="text-xl md:text-2xl font-bold text-provifood-primary">
          ${price.toLocaleString('es-CL')}
        </span>
      </div>
    </div>

    <!-- Botón de agregar -->
    <button
      class="add-to-cart-btn w-full bg-provifood-secondary hover:bg-orange-600 text-white font-semibold py-2.5 md:py-3 px-4 rounded-lg disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors text-sm md:text-base"
      disabled={!isInStock}
      onclick="event.preventDefault(); event.stopPropagation();"
      data-product-id={product.id}
      data-product-sku={product.sku}
      data-product-name={product.name}
      data-product-price={price}
      data-product-image={product.image_url}
      data-product-category={product.category}
      data-product-brand={product.brand}
      data-stock={product.stock || 0}
    >
      {isInStock ? 'Agregar al Carrito' : 'Sin Stock'}
    </button>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  import { addToCart, getQuantityInCart } from '@/stores/cart'
  import type { Product } from '@provifood/types'

  // Agregar al carrito usando Nanostores
  function setupProductCards() {
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const button = e.currentTarget as HTMLElement;

        const product: Product = {
          id: parseInt(button.dataset.productId!),
          sku: button.dataset.productSku || '',
          name: button.dataset.productName!,
          description: '',
          price: parseFloat(button.dataset.productPrice || '0'),
          category: button.dataset.productCategory || '',
          brand: button.dataset.productBrand || null,
          stock: parseInt(button.dataset.stock || '0'),
          image_url: button.dataset.productImage || null,
        };

        // Intentar agregar al carrito
        const success = addToCart(product, 1);

        if (success) {
          // Mostrar confirmación
          const quantityInCart = getQuantityInCart(product.id);
          const units = quantityInCart > 1 ? 'es' : '';
          alert(`✅ ${product.name} agregado al carrito\n\nTienes ${quantityInCart} unidad${units} en tu carrito.`);
        } else {
          // Mostrar error (el store ya da warnings en consola)
          const quantityInCart = getQuantityInCart(product.id);
          if (quantityInCart > 0) {
            alert(`⚠️ Stock insuficiente\n\nSolo hay ${product.stock} unidades disponibles de ${product.name}.\nYa tienes ${quantityInCart} en tu carrito.`);
          } else {
            alert(`⚠️ Producto sin stock\n\n${product.name} no está disponible en este momento.`);
          }
        }
      });
    });
  }

  // Inicializar al cargar
  document.addEventListener('DOMContentLoaded', setupProductCards);
  document.addEventListener('astro:page-load', setupProductCards);
</script>
