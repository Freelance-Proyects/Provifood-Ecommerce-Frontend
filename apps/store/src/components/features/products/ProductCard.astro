---
// Tarjeta de producto para E-commerce
import type { Product } from '@provifood/types';

interface Props {
  product?: Partial<Product>;
  showWholesalePrice?: boolean;
}

const {
  product = {
    name: 'Nombre del Producto',
    price: 0,
    image_url: '',
    stock: 0,
    category: 'Categoría',
    brand: ''
  },
  showWholesalePrice = false
} = Astro.props;

const price = product.price || 0;
const isInStock = (product.stock ?? 0) > 0;
---

<a href={`/producto/${product.id}`} class={`product-card bg-white rounded-lg overflow-hidden border transition-shadow group relative h-full flex flex-col ${!isInStock ? 'border-gray-300 opacity-75' : 'border-gray-200 hover:shadow-xl'}`}>
  <!-- Badge de sin stock -->
  {!isInStock && (
    <div class="absolute top-2 right-2 z-10 bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
      Sin Stock
    </div>
  )}

  <!-- Imagen del producto -->
  <div class="relative bg-white h-48 md:h-56 overflow-hidden flex items-center justify-center p-4 md:p-6 group/image">
    {product.image_url ? (
      <img
        src={product.image_url}
        alt={product.name}
        loading="lazy"
        decoding="async"
        class={`max-w-full max-h-full object-contain ${!isInStock ? 'grayscale opacity-50' : ''}`}
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gray-50 rounded-lg">
        <svg class="w-20 h-20 md:w-24 md:h-24 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}

    <!-- Quick View Button -->
    <button
      class="quick-view-btn absolute inset-0 bg-black/40 opacity-0 group-hover/image:opacity-100 transition-opacity flex items-center justify-center"
      onclick="event.preventDefault(); event.stopPropagation();"
      data-product-id={product.id}
      data-product-sku={product.sku}
      data-product-name={product.name}
      data-product-description={product.description}
      data-product-price={price}
      data-product-image={product.image_url}
      data-product-category={product.category}
      data-product-brand={product.brand}
      data-stock={product.stock || 0}
      aria-label={`Vista rápida de ${product.name}`}
    >
      <div class="bg-white rounded-full p-3 hover:bg-provifood-primary hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      </div>
    </button>

    {!isInStock && (
      <div class="absolute inset-0 bg-black/60 flex items-center justify-center backdrop-blur-[2px]">
        <div class="text-center">
          <svg class="w-12 h-12 md:w-16 md:h-16 text-white mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span class="text-white text-base md:text-lg font-bold">Agotado</span>
        </div>
      </div>
    )}
  </div>

  <!-- Información del producto -->
  <div class="p-3 md:p-4 flex-1 flex flex-col">
    <!-- Marca (opacidad baja) -->
    {product.brand && (
      <p class="text-xs text-gray-400 mb-1 uppercase tracking-wide">
        {product.brand}
      </p>
    )}

    <!-- Nombre del producto (Texto Principal) -->
    <h3 class="text-sm md:text-base font-semibold text-provifood-dark mb-2 md:mb-3 line-clamp-2 flex-1">
      {product.name}
    </h3>

    <!-- Precio (tamaño notable) -->
    <div class="mb-3 md:mb-4">
      <div class="flex items-baseline gap-2">
        <span class="text-xl md:text-2xl font-bold text-provifood-primary">
          ${price.toLocaleString('es-CL')}
        </span>
      </div>
    </div>

    <!-- Botón de agregar -->
    <button
      class="add-to-cart-btn w-full bg-provifood-secondary hover:bg-orange-600 text-white font-semibold py-2.5 md:py-3 px-4 rounded-lg disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors text-sm md:text-base"
      disabled={!isInStock}
      onclick="event.preventDefault(); event.stopPropagation();"
      data-product-id={product.id}
      data-product-sku={product.sku}
      data-product-name={product.name}
      data-product-price={price}
      data-product-image={product.image_url}
      data-product-category={product.category}
      data-product-brand={product.brand}
      data-stock={product.stock || 0}
    >
      {isInStock ? 'Agregar al Carrito' : 'Sin Stock'}
    </button>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  import { addToCart, getQuantityInCart } from '@/stores/cart'
  import { showSuccess, showWarning } from '@/stores/notifications'
  import type { Product } from '@provifood/types'

  // Agregar al carrito usando Nanostores
  function setupProductCards() {
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const button = e.currentTarget as HTMLButtonElement;

        // Prevenir clics múltiples
        if (button.disabled) return;

        const product: Product = {
          id: parseInt(button.dataset.productId!),
          sku: button.dataset.productSku || '',
          name: button.dataset.productName!,
          description: '',
          price: parseFloat(button.dataset.productPrice || '0'),
          category: button.dataset.productCategory || '',
          brand: button.dataset.productBrand || null,
          stock: parseInt(button.dataset.stock || '0'),
          image_url: button.dataset.productImage || null,
        };

        // Verificar si el producto ya está en el carrito
        const wasInCart = getQuantityInCart(product.id) > 0;

        // Mostrar estado de loading
        const originalText = button.innerHTML;
        button.disabled = true;
        button.innerHTML = `
          <svg class="animate-spin h-5 w-5 mx-auto" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        `;

        // Simular un pequeño delay para hacer visible el loading
        setTimeout(() => {
          // Intentar agregar al carrito
          const success = addToCart(product, 1);

          if (success) {
            // Mostrar confirmación
            const quantityInCart = getQuantityInCart(product.id);
            const units = quantityInCart > 1 ? 'es' : '';

            if (wasInCart) {
              showSuccess(
                'Cantidad actualizada',
                `${product.name} - Tienes ${quantityInCart} unidad${units} en tu carrito.`
              );
            } else {
              showSuccess(
                `${product.name} agregado al carrito`,
                `Tienes ${quantityInCart} unidad${units} en tu carrito.`
              );
            }
          } else {
            // Mostrar error (el store ya da warnings en consola)
            const quantityInCart = getQuantityInCart(product.id);
            if (quantityInCart > 0) {
              showWarning(
                'Stock insuficiente',
                `Solo hay ${product.stock} unidades disponibles de ${product.name}. Ya tienes ${quantityInCart} en tu carrito.`
              );
            } else {
              showWarning(
                'Producto sin stock',
                `${product.name} no está disponible en este momento.`
              );
            }
          }

          // Restaurar botón
          button.disabled = false;
          button.innerHTML = originalText;
        }, 300);
      });
    });

    // Quick View buttons
    document.querySelectorAll('.quick-view-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const button = e.currentTarget as HTMLButtonElement;
        const product: Product = {
          id: parseInt(button.dataset.productId!),
          sku: button.dataset.productSku || '',
          name: button.dataset.productName!,
          description: button.dataset.productDescription || '',
          price: parseFloat(button.dataset.productPrice || '0'),
          category: button.dataset.productCategory || '',
          brand: button.dataset.productBrand || null,
          stock: parseInt(button.dataset.stock || '0'),
          image_url: button.dataset.productImage || null,
        };

        if (window.showQuickView) {
          window.showQuickView(product);
        }
      });
    });
  }

  // Inicializar al cargar
  document.addEventListener('DOMContentLoaded', setupProductCards);
  document.addEventListener('astro:page-load', setupProductCards);
</script>
